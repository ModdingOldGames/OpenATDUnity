<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mod SDK: builds OpenAT.Formats.dll from the game sources (same assembly name as the Unity build)
       so code mods can reference it. Mods never ship this DLL: the game provides its own copy. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>OpenAT.Formats</AssemblyName>
    <RootNamespace>OpenAT.Formats</RootNamespace>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/OpenAT/Formats/**/*.cs" Link="Formats/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
